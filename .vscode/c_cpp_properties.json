{
    "configurations": [
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/c++",
            "intelliSenseMode": "linux-gcc-arm64",
            "cppStandard": "c++20",
            "cStandard": "c17",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/tests",
                "${workspaceFolder}/interfaces",
                "${workspaceFolder}/lib/fast_matrix_market/include",
                "${workspaceFolder}/lib/fast_matrix_market/dependencies/fast_float/include",
                "${workspaceFolder}/lib/fast_matrix_market/dependencies/ryu",
                "${workspaceFolder}/lib/fast_matrix_market/dependencies/dragonbox/include",
                "/usr/include",
                "/usr/include/eigen3"
            ],
            "defines": [
                "EIGEN_USE_BLAS",
                "EIGEN_USE_LAPACKE",
                "ENABLE_MAT_EXPORT",
                "FMM_FROM_CHARS_DOUBLE_SUPPORTED",
                "FMM_FROM_CHARS_INT_SUPPORTED",
                "FMM_FROM_CHARS_LONG_DOUBLE_SUPPORTED",
                "FMM_TO_CHARS_DOUBLE_SUPPORTED",
                "FMM_TO_CHARS_INT_SUPPORTED",
                "FMM_TO_CHARS_LONG_DOUBLE_SUPPORTED",
                "FMM_USE_DRAGONBOX",
                "FMM_USE_FAST_FLOAT",
                "FMM_USE_RYU"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/tests",
                    "${workspaceFolder}/interfaces",
                    "${workspaceFolder}/lib/fast_matrix_market/include",
                    "${workspaceFolder}/lib/fast_matrix_market/dependencies/fast_float/include",
                    "${workspaceFolder}/lib/fast_matrix_market/dependencies/ryu",
                    "${workspaceFolder}/lib/fast_matrix_market/dependencies/dragonbox/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
