# Local docker-compose overrides (developer-specific)
compose.override.yaml

# OS metadata
.DS_Store

# CMake/Ninja build trees and scratch areas
build/
tmp/

# Compiled objects and Fortran modules (regenerate on build)
*.o
*.obj
*.mod

# Editor / tooling caches (VS Code, clangd, etc.)
.cache/
.ccls-cache/
cpptools
cpptools-srv
cpptools-wordexp

# External input matrices are user-supplied; keep placeholder only
inputs/*
!inputs/.gitkeep

# Generated solver outputs and logs
outputs/

# Extensionless binaries under tests (e.g., debug executables)
tests/**/[^/]*
!tests/**/
!tests/**/*.*

# Fortran reference suites keep sources but drop compiled artifacts
tests/**/fortran/*.o
tests/**/fortran/*.mod

# Executables with .exe suffix (cross-platform safety)
**/*.exe

# Compilation database generated by CMake (symlinked from build/)
compile_commands.json
