# Local docker-compose overrides (developer-specific)
compose.override.yaml

# OS metadata
.DS_Store

# CMake/Ninja build trees and scratch dirs
build/
tmp/

# Editor / tooling caches
.cache/
.ccls-cache/

# External input matrices are user-supplied; keep placeholder only
inputs/*
!inputs/.gitkeep

# Generated solver outputs and logs
outputs/

# Fortran reference suites ship sources but not compiled artifacts
tests/**/fortran/*
!tests/**/fortran/*.f90
!tests/**/fortran/*.txt
!tests/**/fortran/*.scr

# Ignore extensionless test binaries (e.g., tests/minimal_* executables)
tests/**/[^/]*
!tests/**/
!tests/**/?*.*

# Compilation database generated by CMake (symlink from build/)
compile_commands.json
